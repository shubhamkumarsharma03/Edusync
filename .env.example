# =====================================================================
# EduSync Environment Configuration
# =====================================================================

# --- LLM Provider API Keys ---
# Primary LLM provider
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Fallback LLM provider
OPENAI_API_KEY=your_openai_api_key_here

# --- Database & pgvector Storage ---
# Local PostgreSQL with pgvector extension:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/edusync

# Production / Containerized PostgreSQL (if using Docker network):
# DATABASE_URL=postgresql+asyncpg://edusync:edusync@postgres:5432/edusync

# --- Vector Store Configuration ---
# Uses pgvector directly in PostgreSQL for both local dev and production
VECTOR_STORE_TYPE=pgvector

# --- Background Worker & Task Queue ---
# Local Dev (run in-process without Redis daemon):
CELERY_TASK_ALWAYS_EAGER=true
REDIS_URL=redis://localhost:6379/0

# Production / Docker Redis:
# REDIS_URL=redis://redis:6379/0

# --- Retrieval & Model Parameters ---
CONFIDENCE_THRESHOLD=0.55
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
